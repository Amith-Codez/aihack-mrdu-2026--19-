# Names only. Real values go in web/.env.local (gitignored) and on Vercel (production).
# Primary model: Google Gemini (free tier); fallback: Groq (free plan, OpenAI-compatible)
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MODEL_PRIMARY=gemini-3.8-flash
MODEL_FALLBACK=openai/gpt-oss-120b
# Feature flags (1 = on)
NEXT_PUBLIC_MATCH_ENABLED=1
NEXT_PUBLIC_EVAL_PANEL=1
NEXT_PUBLIC_STORY=0
# Local only, never on Vercel: 1 = canned model outputs for building
CREW_MOCK=
